---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const email = 'kamal.raj2181@gmail.com';
const linkedin = 'https://linkedin.com/in/kamal-raj-75b389b';
---

<section id="contact" style="background:#1A1714;color:#F4EEE3;padding:108px 0;">
  <div style="max-width:1180px;margin:0 auto;padding:0 44px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;">

      <!-- Left -->
      <div>
        <p data-reveal style="font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:#E0764A;margin:0 0 18px;">Contact</p>
        <h2 data-reveal data-reveal-delay="60" style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,56px);letter-spacing:-0.02em;line-height:1.1;margin:0 0 24px;color:#F4EEE3;">Let's talk about your documentation.</h2>
        <p data-reveal data-reveal-delay="120" style="font-size:16px;line-height:1.62;color:#C9BFB0;margin:0 0 40px;max-width:42ch;">
          Whether you need a docs team led, an AI workflow built, or a content system untangled, I'd like to hear about it.
        </p>

        <div data-reveal data-reveal-delay="180" style="border-top:1px solid rgba(244,238,227,0.16);">
          <a href={`mailto:${email}`} style="display:flex;align-items:center;gap:14px;padding:18px 0;border-bottom:1px solid rgba(244,238,227,0.12);text-decoration:none;color:#F4EEE3;transition:transform 180ms ease,padding 180ms ease;"
            onmouseover="this.style.transform='translateX(4px)'" onmouseout="this.style.transform='translateX(0)'">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E0764A" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            <span style="font-size:15px;">{email}</span>
          </a>
          <a href={linkedin} target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;gap:14px;padding:18px 0;border-bottom:1px solid rgba(244,238,227,0.12);text-decoration:none;color:#F4EEE3;transition:transform 180ms ease;"
            onmouseover="this.style.transform='translateX(4px)'" onmouseout="this.style.transform='translateX(0)'">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E0764A" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z"/></svg>
            <span style="font-size:15px;">linkedin.com/in/kamal-raj-75b389b</span>
          </a>
          <a href={`${base}/cv`} style="display:flex;align-items:center;gap:14px;padding:18px 0;border-bottom:1px solid rgba(244,238,227,0.12);text-decoration:none;color:#F4EEE3;transition:transform 180ms ease;"
            onmouseover="this.style.transform='translateX(4px)'" onmouseout="this.style.transform='translateX(0)'">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E0764A" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15l3 3 3-3"/></svg>
            <span style="font-size:15px;">Download CV</span>
          </a>
        </div>
      </div>

      <!-- Right: form -->
      <form id="kr-contact-form" data-reveal data-reveal-delay="120" action={`https://formspree.io/f/xpzgkqyw`} method="POST" style="display:flex;flex-direction:column;gap:24px;">
        <div>
          <label for="name" style="display:block;font-size:11px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#9C9286;margin-bottom:10px;">Name</label>
          <input type="text" id="name" name="name" required style="width:100%;background:#211C17;border:1px solid rgba(244,238,227,0.16);border-radius:10px;padding:14px 16px;font-size:15px;color:#F4EEE3;font-family:inherit;box-sizing:border-box;transition:border-color 180ms ease;"
            onfocus="this.style.borderColor='#E0764A'" onblur="this.style.borderColor='rgba(244,238,227,0.16)'" />
        </div>
        <div>
          <label for="email" style="display:block;font-size:11px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#9C9286;margin-bottom:10px;">Email</label>
          <input type="email" id="email" name="email" required style="width:100%;background:#211C17;border:1px solid rgba(244,238,227,0.16);border-radius:10px;padding:14px 16px;font-size:15px;color:#F4EEE3;font-family:inherit;box-sizing:border-box;transition:border-color 180ms ease;"
            onfocus="this.style.borderColor='#E0764A'" onblur="this.style.borderColor='rgba(244,238,227,0.16)'" />
        </div>
        <div>
          <label for="message" style="display:block;font-size:11px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#9C9286;margin-bottom:10px;">Message</label>
          <textarea id="message" name="message" rows="5" required style="width:100%;background:#211C17;border:1px solid rgba(244,238,227,0.16);border-radius:10px;padding:14px 16px;font-size:15px;color:#F4EEE3;font-family:inherit;box-sizing:border-box;resize:vertical;transition:border-color 180ms ease;"
            onfocus="this.style.borderColor='#E0764A'" onblur="this.style.borderColor='rgba(244,238,227,0.16)'"></textarea>
        </div>
        <div style="display:flex;align-items:center;gap:16px;">
          <button type="submit" id="kr-submit" style="display:inline-flex;align-items:center;gap:8px;background:#B4471F;color:#F4EEE3;border:none;border-radius:10px;padding:14px 28px;font-size:14px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;cursor:pointer;font-family:inherit;transition:transform 180ms ease,background 180ms ease;"
            onmouseover="this.style.background='#8F3415';this.style.transform='translateY(-3px)'" onmouseout="this.style.background='#B4471F';this.style.transform='translateY(0)'">
            <span id="kr-submit-text">Send message</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>
          </button>
          <span id="kr-success" style="display:none;font-size:14px;color:#8FCB9B;align-items:center;gap:6px;">Sent. I'll be in touch shortly.</span>
        </div>
      </form>

    </div>
  </div>

  <script is:inline>
    (function () {
      var form = document.getElementById('kr-contact-form');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = document.getElementById('kr-submit');
        var btnText = document.getElementById('kr-submit-text');
        var success = document.getElementById('kr-success');
        var data = new FormData(form);
        fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } })
          .then(function (res) {
            if (res.ok) {
              btnText.textContent = 'Sent';
              success.style.display = 'inline-flex';
              form.reset();
            } else {
              btnText.textContent = 'Try again';
            }
          })
          .catch(function () { btnText.textContent = 'Try again'; });
      });
    })();
  </script>
</section>
