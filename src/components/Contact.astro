---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const email = 'kamal.raj2181@gmail.com';
const linkedin = 'https://linkedin.com/in/kamal-raj-75b389b';
---

<section id="contact" class="contact">
  <div class="cds-container">
    <div class="contact__grid">
      <div class="contact__left">
        <p class="type-label contact__label" data-reveal>Contact</p>
        <h2 class="type-h2 contact__h2" data-reveal data-reveal-delay="60">Get in touch.</h2>
        <p class="contact__intro" data-reveal data-reveal-delay="120">Always glad to connect with writers, engineers, and teams working on documentation, developer experience, and AI tooling. Send a note and I'll reply.</p>

        <div class="contact__rows" data-reveal data-reveal-delay="180">
          <a href={`mailto:${email}`} class="contact__row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="1"/><path d="m22 7-10 5L2 7"/></svg>
            <span>{email}</span>
          </a>
          <a href={linkedin} target="_blank" rel="noopener noreferrer" class="contact__row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z"/></svg>
            <span>linkedin.com/in/kamal-raj-75b389b</span>
          </a>
          <a href={`${base}/cv`} class="contact__row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15l3 3 3-3"/></svg>
            <span>Download CV</span>
          </a>
        </div>
      </div>

      <form id="kr-contact-form" class="contact__form" data-reveal data-reveal-delay="120">
        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <div class="contact__submit">
          <button type="submit" class="btn btn--primary" id="kr-submit">
            <span id="kr-submit-text">Send message</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>
          </button>
          <span id="kr-success" class="contact__success">Your email app should open with the message ready to send.</span>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact { background: var(--cds-inverse-bg); color: var(--cds-inverse-text); padding: var(--sp-11) 0; }
  @media (min-width: 1056px) { .contact { padding: var(--sp-12) 0; } }
  .contact__grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-09); }
  @media (min-width: 900px) { .contact__grid { grid-template-columns: 1fr 1fr; gap: var(--sp-10); } }
  .contact__label { color: var(--cds-inverse-link); }
  .contact__h2 { color: #fff; margin: var(--sp-04) 0 var(--sp-05); }
  .contact__intro { font-size: 1rem; line-height: 1.55; color: #c6c6c6; max-width: 42ch; margin: 0 0 var(--sp-08); }
  .contact__rows { border-top: 1px solid #393939; }
  .contact__row { display: flex; align-items: center; gap: var(--sp-04); padding: var(--sp-05) 0; border-bottom: 1px solid #393939; color: #f4f4f4; text-decoration: none; transition: transform 160ms var(--cds-ease-productive); }
  .contact__row svg { color: var(--cds-inverse-link); flex-shrink: 0; }
  .contact__row:hover { transform: translateX(4px); }
  .contact__row span { font-size: 0.9375rem; word-break: break-word; }

  .field { margin-bottom: var(--sp-06); }
  .field label { display: block; font-size: 0.75rem; color: #a8a8a8; margin-bottom: var(--sp-03); }
  .field input, .field textarea {
    width: 100%; background: var(--cds-inverse-layer); border: none; border-bottom: 1px solid #6f6f6f;
    padding: var(--sp-04) var(--sp-05); font-family: inherit; font-size: 0.9375rem; color: #f4f4f4;
    border-radius: 0; transition: border-color 110ms; resize: vertical;
  }
  .field input:focus, .field textarea:focus { outline: 2px solid var(--cds-interactive); outline-offset: -2px; border-bottom-color: transparent; }
  .contact__submit { display: flex; align-items: center; gap: var(--sp-05); flex-wrap: wrap; }
  .contact__success { display: none; font-size: 0.875rem; color: var(--cds-support-success); }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('kr-contact-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var success = document.getElementById('kr-success');
      var name = (form.querySelector('#name') || {}).value || '';
      var email = (form.querySelector('#email') || {}).value || '';
      var message = (form.querySelector('#message') || {}).value || '';
      var subject = 'Portfolio enquiry from ' + name;
      var body = message + '\n\nFrom: ' + name + ' (' + email + ')';
      var href = 'mailto:kamal.raj2181@gmail.com'
        + '?subject=' + encodeURIComponent(subject)
        + '&body=' + encodeURIComponent(body);
      window.location.href = href;
      success.style.display = 'inline';
    });
  })();
</script>
