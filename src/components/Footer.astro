---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const email = 'kamal.raj2181@gmail.com';
const linkedin = 'https://linkedin.com/in/kamal-raj-75b389b';
---

<footer style="background:#1A1714;color:#C9BFB0;padding:0 0 48px;">
  <div style="max-width:1180px;margin:0 auto;padding:0 44px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:32px;padding-bottom:36px;">
      <div>
        <div style="font-family:'Newsreader',serif;font-size:26px;font-weight:400;letter-spacing:-0.015em;color:#F4EEE3;margin-bottom:6px;">Kamal Raj</div>
        <div style="font-size:13px;letter-spacing:0.04em;color:#8A8175;">Staff Technical Writer · Developer Docs &amp; AI Tooling</div>
      </div>
      <div style="display:flex;gap:28px;">
        <a href={`mailto:${email}`} style="font-size:13px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:#C9BFB0;text-decoration:none;transition:color 180ms ease;" onmouseover="this.style.color='#E0764A'" onmouseout="this.style.color='#C9BFB0'">Email</a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer" style="font-size:13px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:#C9BFB0;text-decoration:none;transition:color 180ms ease;" onmouseover="this.style.color='#E0764A'" onmouseout="this.style.color='#C9BFB0'">LinkedIn</a>
        <a href={`${base}/cv`} style="font-size:13px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:#C9BFB0;text-decoration:none;transition:color 180ms ease;" onmouseover="this.style.color='#E0764A'" onmouseout="this.style.color='#C9BFB0'">CV</a>
      </div>
    </div>
    <div style="border-top:1px solid rgba(244,238,227,0.12);padding-top:28px;">
      <p style="font-size:12px;color:#8A8175;margin:0;">© 2026 Kamal Raj. All rights reserved.</p>
    </div>
  </div>
</footer>
