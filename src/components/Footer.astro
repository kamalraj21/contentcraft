---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const email = 'kamal.raj2181@gmail.com';
const linkedin = 'https://linkedin.com/in/kamal-raj-75b389b';
---

<footer class="footer">
  <div class="cds-container">
    <div class="footer__top">
      <div>
        <div class="footer__name">Kamal Raj</div>
        <div class="footer__role mono">Staff Technical Writer · Developer Docs &amp; AI Tooling</div>
      </div>
      <div class="footer__links">
        <a href={`mailto:${email}`}>Email</a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={`${base}/cv`}>CV</a>
      </div>
    </div>
    <div class="footer__bottom">
      <p>© 2026 Kamal Raj. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--cds-inverse-bg); color: #c6c6c6; padding-bottom: var(--sp-08); }
  .footer__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: var(--sp-06); padding: var(--sp-08) 0; }
  .footer__name { font-size: 1.25rem; font-weight: 600; color: #fff; margin-bottom: var(--sp-02); }
  .footer__role { font-size: 0.8125rem; color: #8d8d8d; }
  .footer__links { display: flex; gap: var(--sp-07); }
  .footer__links a { font-size: 0.8125rem; color: #c6c6c6; text-decoration: none; text-transform: uppercase; letter-spacing: 0.06em; transition: color 110ms; }
  .footer__links a:hover { color: var(--cds-inverse-link); }
  .footer__bottom { border-top: 1px solid #393939; padding-top: var(--sp-06); }
  .footer__bottom p { font-size: 0.75rem; color: #6f6f6f; margin: 0; }
</style>
