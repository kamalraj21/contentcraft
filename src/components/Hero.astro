---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stats = [
  { value: '18', suffix: '', label: 'Years in documentation' },
  { value: '10', suffix: '', label: 'AI assistants built' },
  { value: '80', suffix: '%', label: 'Faster first drafts' },
  { value: '70', suffix: '%', label: 'Shorter review cycles' },
];
const ticker = ['RAG','MCP','Agentic Search','Python','C++','DITA','Sphinx','reStructuredText','Markdown','GitHub Actions','CI/CD','Oxygen XML','Perforce'];
---

<header id="top" class="hero">
  <div class="cds-container">
    <div class="hero__eyebrow" data-reveal>
      <span class="type-label" style="margin:0;">Staff Technical Writer</span>
      <span class="hero__divider"></span>
      <span class="type-meta">Developer Docs &amp; AI Tooling</span>
    </div>

    <h1 class="type-display hero__title" data-reveal data-reveal-delay="60">
      Documentation developers <span class="hero__accent">actually trust</span>, built with AI that earns its place.
    </h1>

    <div class="hero__grid">
      <div class="hero__intro" data-reveal data-reveal-delay="120">
        <p class="type-lead">
          For 18 years I have owned developer documentation for fast-moving platforms at companies like Intel and Salesforce. Most recently I designed a suite of ten AI assistants for a team of eight writers, cutting first-draft time by 80% and review cycles by 70% with no drop in editorial quality.
        </p>
        <div class="hero__ctas">
          <a href={`${base}/#work`} class="btn btn--primary">
            View selected work
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={`${base}/#contact`} class="btn btn--ghost">
            Get in touch
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        <p class="hero__orgs mono">Salesforce · Intel · Rakuten · Netcracker · Oracle</p>
      </div>

      <div class="hero__stats" data-reveal data-reveal-delay="180">
        {stats.map(s => (
          <div class="hero__stat">
            <div class="hero__stat-num"><span class="kr-count" data-count={s.value}>{s.value}</span>{s.suffix}</div>
            <div class="hero__stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="ticker">
    <div class="ticker__track">
      {[...ticker, ...ticker].map((t, i) => (
        <span class="ticker__item" aria-hidden={i >= ticker.length ? 'true' : undefined}>{t}</span>
      ))}
    </div>
  </div>
</header>

<style>
  .hero { padding-top: 96px; }
  @media (min-width: 672px) { .hero { padding-top: 128px; } }
  @media (min-width: 1056px) { .hero { padding-top: 160px; } }

  .hero__eyebrow { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: var(--sp-06); }
  .hero__divider { width: 24px; height: 1px; background: var(--cds-border-strong); }

  .hero__title { max-width: 16ch; margin-bottom: var(--sp-08); text-wrap: balance; }
  .hero__accent { color: var(--cds-link-primary); }

  .hero__grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-08); align-items: end; }
  @media (min-width: 1056px) { .hero__grid { grid-template-columns: 1.4fr 1fr; gap: var(--sp-10); } }

  .hero__intro .type-lead { max-width: 60ch; margin: 0 0 var(--sp-07); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--sp-03); }
  .hero__orgs { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cds-text-helper); margin: var(--sp-06) 0 0; }

  .hero__stats {
    display: grid; grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--cds-border-subtle); border-left: 1px solid var(--cds-border-subtle);
  }
  .hero__stat { padding: var(--sp-05) var(--sp-05) var(--sp-06); border-right: 1px solid var(--cds-border-subtle); border-bottom: 1px solid var(--cds-border-subtle); }
  .hero__stat-num { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 300; letter-spacing: -0.02em; line-height: 1; margin-bottom: var(--sp-03); }
  .hero__stat-label { font-size: 0.8125rem; color: var(--cds-text-helper); }

  .ticker { margin-top: var(--sp-11); border-top: 1px solid var(--cds-border-subtle); border-bottom: 1px solid var(--cds-border-subtle); overflow: hidden; position: relative; }
  .ticker__track { display: flex; width: max-content; animation: kr-marquee 44s linear infinite; }
  .ticker__item { padding: 14px 24px; font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cds-text-helper); white-space: nowrap; }
  @keyframes kr-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker__track { animation: none; } }
</style>

<script>
  const counters = document.querySelectorAll('.kr-count');
  const run = (el) => {
    const target = parseInt(el.getAttribute('data-count') || '0', 10);
    const start = performance.now(); const dur = 1200;
    const tick = (now) => {
      const p = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { run(e.target); io.unobserve(e.target); } });
  }, { threshold: 0.5 });
  counters.forEach(c => io.observe(c));
</script>
