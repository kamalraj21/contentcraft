<header id="top" style="position:relative;max-width:1180px;margin:0 auto;padding:172px 44px 88px;">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:34px;">
    <span data-reveal style="font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:#B4471F;">Staff Technical Writer</span>
    <span data-reveal style="width:24px;height:1px;background:#C9BFB0;display:inline-block;"></span>
    <span data-reveal style="font-size:12px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#9C9286;">Developer Docs &amp; AI Tooling</span>
  </div>

  <h1 data-reveal data-reveal-delay="60" style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(44px,6.4vw,86px);line-height:1.02;letter-spacing:-0.022em;margin:0 0 32px;max-width:14ch;text-wrap:balance;">
    Documentation developers <em style="font-style:italic;font-weight:400;color:#B4471F;">actually trust</em>, built with AI that earns its place.
  </h1>

  <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:64px;align-items:end;">
    <div>
      <p data-reveal data-reveal-delay="140" style="font-size:19px;line-height:1.62;color:#4A443B;max-width:600px;margin:0 0 36px;text-wrap:pretty;">
        For 18 years I have owned developer documentation for fast-moving platforms at companies like Intel and Salesforce. Most recently I designed a suite of ten AI assistants for a team of eight writers, cutting first-draft time by 80% and review cycles by 70% with no drop in editorial quality. Equal parts technical writer, information architect, and builder.
      </p>
      <div data-reveal data-reveal-delay="220" style="display:flex;gap:14px;flex-wrap:wrap;">
        <a href="#work" style="text-decoration:none;display:inline-flex;align-items:center;gap:9px;background:#B4471F;color:#F8F4EC;font-size:16px;font-weight:600;padding:14px 26px;border-radius:10px;transition:transform 180ms cubic-bezier(0.22,1,0.36,1),background 180ms ease;">
          View selected work
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="#contact" style="text-decoration:none;display:inline-flex;align-items:center;gap:9px;background:transparent;color:#211C17;font-size:16px;font-weight:600;padding:14px 24px;border-radius:10px;border:1px solid rgba(33,28,23,0.22);transition:transform 180ms ease,background 180ms ease,border-color 180ms ease;">
          Get in touch
        </a>
      </div>
    </div>

    <!-- Ledger stat block -->
    <div data-reveal data-reveal-delay="180" style="display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(33,28,23,0.16);border-left:1px solid rgba(33,28,23,0.16);">
      <div style="padding:20px 18px;border-right:1px solid rgba(33,28,23,0.16);border-bottom:1px solid rgba(33,28,23,0.16);">
        <div style="font-family:'Newsreader',serif;font-weight:400;font-size:46px;line-height:0.95;letter-spacing:-0.02em;"><span data-count="18">18</span></div>
        <div style="font-size:12.5px;color:#6B6358;margin-top:8px;letter-spacing:0.01em;">years writing docs</div>
      </div>
      <div style="padding:20px 18px;border-bottom:1px solid rgba(33,28,23,0.16);">
        <div style="font-family:'Newsreader',serif;font-weight:400;font-size:46px;line-height:0.95;letter-spacing:-0.02em;"><span data-count="10">10</span></div>
        <div style="font-size:12.5px;color:#6B6358;margin-top:8px;">AI assistants shipped</div>
      </div>
      <div style="padding:20px 18px;border-right:1px solid rgba(33,28,23,0.16);border-bottom:1px solid rgba(33,28,23,0.16);">
        <div style="font-family:'Newsreader',serif;font-weight:400;font-size:46px;line-height:0.95;letter-spacing:-0.02em;"><span data-count="80">80</span>%</div>
        <div style="font-size:12.5px;color:#6B6358;margin-top:8px;">faster first drafts</div>
      </div>
      <div style="padding:20px 18px;border-bottom:1px solid rgba(33,28,23,0.16);">
        <div style="font-family:'Newsreader',serif;font-weight:400;font-size:46px;line-height:0.95;letter-spacing:-0.02em;"><span data-count="70">70</span>%</div>
        <div style="font-size:12.5px;color:#6B6358;margin-top:8px;">shorter review cycles</div>
      </div>
    </div>
  </div>
</header>

<!-- Tech ticker -->
<style is:global>
  @keyframes kr-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .kr-ticker-track { animation: none !important; }
  }
</style>
<div style="border-top:1px solid rgba(33,28,23,0.14);border-bottom:1px solid rgba(33,28,23,0.14);padding:15px 0;overflow:hidden;position:relative;">
  <div style="position:absolute;left:0;top:0;bottom:0;width:90px;z-index:2;background:linear-gradient(90deg,#F4EEE3,transparent);pointer-events:none;"></div>
  <div style="position:absolute;right:0;top:0;bottom:0;width:90px;z-index:2;background:linear-gradient(270deg,#F4EEE3,transparent);pointer-events:none;"></div>
  <div class="kr-ticker-track" style="display:flex;width:max-content;animation:kr-marquee 44s linear infinite;">
    {['RAG','MCP','Agentic Search','Python','C++','DITA','Sphinx','reStructuredText','Markdown','GitHub Actions','CI/CD','Oxygen XML','Perforce'].flatMap((t, i, a) => [
      <span style="padding:0 26px;font-size:12px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:#8A8175;white-space:nowrap;">{t}</span>,
      i < a.length - 1 ? <span style="color:#C9BFB0;">·</span> : null
    ]).concat(
      ['RAG','MCP','Agentic Search','Python','C++','DITA','Sphinx','reStructuredText','Markdown','GitHub Actions','CI/CD','Oxygen XML','Perforce'].flatMap((t, i, a) => [
        <span aria-hidden="true" style="padding:0 26px;font-size:12px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:#8A8175;white-space:nowrap;">{t}</span>,
        i < a.length - 1 ? <span aria-hidden="true" style="color:#C9BFB0;">·</span> : null
      ])
    )}
  </div>
</div>

<script>
  // Count-up animation — seed final value immediately so zeros never show
  const counters = Array.from(document.querySelectorAll('[data-count]'));
  counters.forEach(c => { c.textContent = c.getAttribute('data-count'); });

  const animateCount = (el: Element) => {
    if ((el as any)._counted) return;
    (el as any)._counted = true;
    const target = parseFloat(el.getAttribute('data-count') || '0');
    const dur = 1400;
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = Math.round(target * eased).toString();
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = target.toString();
    };
    requestAnimationFrame(step);
  };

  const countObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('[data-count]').forEach(animateCount);
      }
    });
  }, { threshold: 0.5 });

  const statBlock = document.querySelector('[data-reveal-delay="180"]');
  if (statBlock) countObserver.observe(statBlock);
</script>
