---
const roles = [
  { dates: 'Jan 2025 – Present', title: 'Staff Technical Writer', company: 'Salesforce', note: 'Built ten production Slackbot AI skills for content writers using RAG, MCP, and agentic workflows; cut first-draft time by 80% and review cycles by 70%. Led a docs strategy adopted at VP level.' },
  { dates: 'Aug 2021 – Nov 2024', title: 'Developer Experience Technical Writer', company: 'Intel Corporation', note: 'Led documentation for IoT, edge computing, and AI/ML platforms with Python SDK samples; cut developer onboarding time by 25%. Managed a team of four writers.' },
  { dates: 'Feb 2021 – Jul 2021', title: 'Senior Technical Writer', company: 'Rakuten', note: 'Created developer and DevOps documentation for Big Data platforms, collaborating on content strategy and UI copy standards.' },
  { dates: 'Oct 2018 – Jan 2021', title: 'Senior Technical Writer', company: 'Netcracker Technology', note: 'Managed documentation for cloud services and network management platforms; aligned to Google developer style guidelines and adopted docs-as-code workflows with Git and Confluence.' },
  { dates: 'Nov 2017 – Jun 2018', title: 'Senior Technical Writer', company: 'AgilePoint', note: 'Created DITA-based online help systems, improving content reusability by 40%.' },
  { dates: 'Jun 2015 – May 2016', title: 'Senior Technical Writer', company: 'Evolving Systems', note: 'Developed user guides, tutorials, and infographics, reducing customer training time by 20%.' },
  { dates: 'Jun 2014 – Apr 2015', title: 'Technical Writer', company: 'Novell Software Development', note: 'Authored administrator guides and tutorials, improving feature adoption by 25%.' },
  { dates: 'Jun 2011 – Feb 2014', title: 'Technical Writer', company: 'Oracle India', note: 'Authored ERP and Order Management documentation. Received 95% satisfaction from implementation teams.' },
  { dates: 'Jun 2010 – May 2011', title: 'Product Information Specialist', company: 'Unisys India', note: 'Rebranded over 1,000 pages of legacy documentation, improving readability scores by 40%.' },
  { dates: 'Aug 2008 – May 2010', title: 'Technical Writer', company: 'Phantasm Games Studio', note: 'Authored game design documents, tools guides, and workflow documentation.' },
];
---

<section id="experience" style="padding:108px 0;border-top:1px solid rgba(33,28,23,0.10);">
  <div style="max-width:1180px;margin:0 auto;padding:0 44px;">

    <div data-reveal style="margin-bottom:56px;">
      <p style="font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:#B4471F;margin:0 0 18px;">Experience</p>
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(32px,4.4vw,56px);letter-spacing:-0.02em;line-height:1.1;margin:0;">Eighteen years of making platforms make sense.</h2>
    </div>

    <div style="border-top:1px solid rgba(33,28,23,0.12);">
      {roles.map((r, i) => (
        <div data-reveal data-reveal-delay={`${Math.min(i * 40, 220)}`}
          style="display:grid;grid-template-columns:170px 1fr;gap:40px;padding:28px 0;border-bottom:1px solid rgba(33,28,23,0.10);align-items:baseline;">
          <div style="font-size:13px;color:#8A8175;font-weight:400;padding-top:2px;">{r.dates}</div>
          <div>
            <div style="font-family:'Newsreader',serif;font-size:20px;font-weight:400;letter-spacing:-0.012em;color:#211C17;margin-bottom:3px;">{r.title}</div>
            <div style="font-size:13px;font-weight:600;color:#B4471F;letter-spacing:0.04em;margin-bottom:6px;">{r.company}</div>
            <div style="font-size:14px;line-height:1.55;color:#6B6358;">{r.note}</div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
