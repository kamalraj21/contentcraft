---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const featured = {
  title: 'Salesforce AI Skills Programme',
  role: 'Information Architect + AI Tooling, Salesforce',
  blurb: 'Designed and built ten production AI tools scoped to the real friction points in an eight-writer team: draft generation from engineering specs, RAG-grounded fact-checking, MCP-connected context retrieval, an agentic review pipeline, and a Slack-native interface.',
  chips: ['RAG', 'MCP', 'Slack', 'Python', 'Salesforce Einstein'],
  stats: [
    { value: '10', label: 'AI tools shipped' },
    { value: '80%', label: 'faster doc cycles' },
    { value: '8', label: 'writers enabled' },
    { value: '4.5/5', label: 'Salesforce AI Expo' },
  ],
  href: `${base}/projects/salesforce-ai-skills`,
};

const projects = [
  { num: '01', title: 'Intel OpenVINO Developer Docs', role: 'Technical Writer + Information Architect, Intel', blurb: 'Owned the full information architecture for two AI inference toolchains, OpenVINO and Tiber Edge AI: taxonomy, navigation, versioning, and the core developer guides.', href: `${base}/projects/intel-openvino`, target: '_self', stats: [{ value: '2', label: 'AI platforms' }, { value: 'End-to-end', label: 'dev journey' }] },
  { num: '02', title: 'Headless Documentation & MCP', role: 'ContentOps, Intel + independent prototype', blurb: 'Moved docs from a heavyweight CMS to GitHub as a headless CMS with one-click publishing, then built a working MCP prototype that serves the same content to AI agents.', href: `${base}/projects/headless-docs`, target: '_self', stats: [{ value: 'One click', label: 'publishing' }, { value: 'MCP', label: 'agent-ready' }] },
  { num: '03', title: 'Enterprise Documentation Redesign', role: 'Information Architect, Intel', blurb: 'Led a complete overhaul of a fragmented enterprise documentation system: a unified content hub, task-based navigation, and a real-time update pipeline.', href: `${base}/projects/documentation-redesign`, target: '_self', stats: [{ value: '35%', label: 'higher satisfaction' }, { value: 'Unified', label: 'content hub' }] },
  { num: '04', title: 'Microlearning at Intel', role: 'Learning Design + Content Strategy, Intel', blurb: 'Transformed dense technical documentation into bite-sized interactive modules, cutting learning time by 50% while improving knowledge retention.', href: `${base}/projects/microlearning`, target: '_self', stats: [{ value: '50%', label: 'less learning time' }, { value: '45 → 5', label: 'pages to modules' }] },
  { num: '05', title: 'DocPilot × IceCream', role: 'AI Documentation + DevOps, independent project', blurb: 'Auto-generated comprehensive API documentation for a 10,000-star Python library with zero docstrings, using AI agents, CI/CD pipelines, and automated quality gates.', href: `${base}/projects/docpilot-icecream`, target: '_self', stats: [{ value: '100%', label: 'docstring coverage' }, { value: '96.2', label: 'AI quality score' }] },
  { num: '06', title: 'Axon Networks DITA Pipeline', role: 'Information Architect + DITA Author, independent project', blurb: 'A hand-authored DITA 1.3 documentation system for an enterprise network OS: six structured topics, two ditamaps, one reusable conref fragment, zero duplicated content.', href: 'https://github.com/kamalraj21/axon-docs', target: '_blank', stats: [{ value: '6', label: 'DITA topics' }, { value: '0', label: 'duplicated' }] },
];
---

<section id="work" class="cds-section">
  <div class="cds-container">
    <div class="work__head" data-reveal>
      <p class="type-label">Selected work</p>
      <h2 class="type-h2">Projects that shipped and held.</h2>
      <p class="type-body work__note">A mix of enterprise deliverables, independent builds, and tools I designed from scratch.</p>
    </div>

    <!-- Featured tile -->
    <article class="feature" data-reveal data-reveal-delay="60">
      <div class="feature__body">
        <p class="type-label type-label--muted feature__kicker">Flagship case study</p>
        <h3 class="type-h3">{featured.title}</h3>
        <p class="feature__role mono">{featured.role}</p>
        <p class="type-body feature__blurb">{featured.blurb}</p>
        <div class="feature__tags">
          {featured.chips.map(c => <span class="tag">{c}</span>)}
        </div>
        <a href={featured.href} class="btn btn--primary">
          Read case study
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </a>
      </div>
      <div class="feature__stats">
        {featured.stats.map(s => (
          <div class="feature__stat">
            <div class="feature__stat-num">{s.value}</div>
            <div class="feature__stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </article>

    <!-- Editorial rows -->
    <div class="rows">
      {projects.map((p, i) => (
        <a href={p.href} target={p.target} rel={p.target === '_blank' ? 'noopener noreferrer' : undefined} class="row" data-reveal data-reveal-delay={`${60 + i * 50}`}>
          <span class="row__num mono">{p.num}</span>
          <div class="row__main">
            <div class="row__title">{p.title}</div>
            <div class="row__role">{p.role}</div>
            <div class="row__blurb">{p.blurb}</div>
          </div>
          <div class="row__stats">
            {p.stats.map(s => (
              <div class="row__stat">
                <div class="row__stat-num">{s.value}</div>
                <div class="row__stat-label">{s.label}</div>
              </div>
            ))}
            <svg class="row__arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .work__head { margin-bottom: var(--sp-08); }
  .work__head .type-h2 { margin: var(--sp-04) 0 var(--sp-04); }
  .work__note { margin: 0; }

  .feature { border: 1px solid var(--cds-border-subtle); background: var(--cds-layer-02); display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1056px) { .feature { grid-template-columns: 1.2fr 1fr; } }
  .feature__body { padding: var(--sp-07); }
  @media (min-width: 672px) { .feature__body { padding: var(--sp-09); } }
  .feature__kicker { margin-bottom: var(--sp-06); }
  .feature__role { font-size: 0.8125rem; color: var(--cds-text-helper); margin: var(--sp-03) 0 var(--sp-05); }
  .feature__blurb { margin: 0 0 var(--sp-06); }
  .feature__tags { display: flex; flex-wrap: wrap; gap: var(--sp-03); margin-bottom: var(--sp-07); }

  .feature__stats { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--cds-border-subtle); }
  @media (min-width: 1056px) { .feature__stats { border-top: none; border-left: 1px solid var(--cds-border-subtle); } }
  .feature__stat { padding: var(--sp-06); border-bottom: 1px solid var(--cds-border-subtle); }
  .feature__stat:nth-child(odd) { border-right: 1px solid var(--cds-border-subtle); }
  .feature__stat-num { font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 300; letter-spacing: -0.02em; line-height: 1; margin-bottom: var(--sp-03); }
  .feature__stat-label { font-size: 0.8125rem; color: var(--cds-text-helper); }

  .rows { margin-top: var(--sp-09); border-top: 1px solid var(--cds-border-subtle); }
  .row { display: grid; grid-template-columns: 32px 1fr; gap: var(--sp-04); padding: var(--sp-06) 0; border-bottom: 1px solid var(--cds-border-subtle); text-decoration: none; color: inherit; transition: padding 160ms var(--cds-ease-productive), background 160ms; }
  .row:hover { background: var(--cds-layer-01); padding-left: var(--sp-04); padding-right: var(--sp-04); }
  @media (min-width: 900px) { .row { grid-template-columns: 40px 1fr auto; align-items: center; gap: var(--sp-07); } }
  .row__num { color: var(--cds-text-placeholder); font-size: 0.875rem; }
  .row__title { font-size: 1.25rem; font-weight: 400; margin-bottom: var(--sp-02); }
  .row__role { font-size: 0.8125rem; color: var(--cds-text-helper); margin-bottom: var(--sp-03); }
  .row__blurb { font-size: 0.9375rem; line-height: 1.5; color: var(--cds-text-secondary); }
  .row__stats { grid-column: 2; display: flex; align-items: center; gap: var(--sp-06); margin-top: var(--sp-04); }
  @media (min-width: 900px) { .row__stats { grid-column: auto; flex-direction: column; align-items: flex-end; gap: var(--sp-03); margin-top: 0; min-width: 130px; } }
  .row__stat { text-align: left; }
  @media (min-width: 900px) { .row__stat { text-align: right; } }
  .row__stat-num { font-size: 1.0625rem; font-weight: 400; }
  .row__stat-label { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--cds-text-helper); }
  .row__arrow { color: var(--cds-link-primary); flex-shrink: 0; }
</style>
