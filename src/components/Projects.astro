---
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.sort_order - b.data.sort_order);
---

<section id="work" class="py-16 sm:py-24 bg-gradient-to-b from-white to-[#EEFBFB]/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center mb-16">
      <h2 class="text-3xl font-bold leading-tight tracking-tight text-[#12232e] sm:text-4xl mb-4">
        Work
      </h2>
      <p class="text-lg leading-relaxed text-slate-600">
        Documentation systems and AI tooling shipped in production.
      </p>
    </div>

    <div class="grid gap-6 sm:gap-8 grid-cols-1 md:grid-cols-2">
      {featuredProjects.map((project) => {
        const { title, role_tag, description, outcome_metrics, tech_stack, github_repo, case_study_url, primary_track } = project.data;
        const cardHref = case_study_url || github_repo;
        const CardTag = cardHref ? 'a' : 'div';
        const cardProps = case_study_url
          ? { href: case_study_url }
          : github_repo
          ? { href: github_repo, target: '_blank', rel: 'noopener noreferrer' }
          : {};

        return (
          <CardTag
            {...cardProps}
            data-primary-track={primary_track}
            class="block p-6 sm:p-8 rounded-xl bg-white/80 backdrop-blur-sm border border-[#4DA8DA]/20 hover:border-[#007CC7]/50 hover:bg-gradient-to-b hover:from-white hover:to-[#EEFBFB]/60 hover:-translate-y-1 hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#007CC7] transition-all duration-300"
          >
            <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
              <h3 class="text-xl font-semibold leading-tight text-[#12232e]">{title}</h3>
              <span class="shrink-0 px-3 py-1 rounded-full text-xs font-mono bg-[#EEFBFB] text-[#007CC7] border border-[#4DA8DA]/40">
                {role_tag}
              </span>
            </div>

            <p class="text-slate-600 leading-relaxed mb-6">{description}</p>

            {tech_stack?.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-6">
                {tech_stack.map((tech) => (
                  <span class="px-2 py-1 rounded-md text-xs font-mono bg-slate-50 text-slate-600 border border-slate-200">
                    {tech}
                  </span>
                ))}
              </div>
            )}

            <div class="grid grid-cols-3 gap-4 pt-4 border-t border-[#4DA8DA]/20">
              {outcome_metrics.map((metric) => (
                <div>
                  <p class="text-xl sm:text-2xl font-semibold bg-gradient-to-r from-[#007CC7] to-[#12232e] bg-clip-text text-transparent">
                    {metric.value}
                  </p>
                  <p class="text-xs text-slate-600">{metric.label}</p>
                </div>
              ))}
            </div>
          </CardTag>
        );
      })}
    </div>
  </div>
</section>
