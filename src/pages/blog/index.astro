---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Blog — Kamal Raj">
  <main class="cds-section" style="padding-top:120px;">
    <div class="cds-container" style="max-width:820px;">
      <p class="type-label">Writing</p>
      <h1 class="type-h2" style="margin:12px 0 32px;">Blog</h1>
      <div style="border-top:1px solid var(--cds-border-subtle);">
        {posts.length === 0 && (
          <p class="type-body" style="padding:32px 0;">No posts yet.</p>
        )}
        {posts.map(post => (
          <a href={`${base}/blog/${post.id}/`} style="display:block;padding:24px 0;border-bottom:1px solid var(--cds-border-subtle);text-decoration:none;color:inherit;">
            <div style="font-size:1.25rem;font-weight:400;margin-bottom:6px;color:var(--cds-link-primary);">{post.data.title}</div>
            <p class="type-body" style="margin:0 0 6px;">{post.data.description}</p>
            <small class="type-meta">{post.data.pubDate}</small>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
