---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { post } = Astro.props;
if (!post) {
  throw new Error(`Post not found for slug: ${Astro.params.slug}`);
}
const { title, pubDate, description, author } = post.data;
const { Content } = await post.render();
---

<Layout title={`${title} — Kamal Raj`} description={description}>
  <main class="cds-section" style="padding-top:120px;">
    <div class="cds-container" style="max-width:720px;">
      <a href={`${base}/blog/`} class="cds-link" style="font-size:0.875rem;">← Back to blog</a>
      <header style="margin:24px 0 32px;padding-bottom:24px;border-bottom:1px solid var(--cds-border-subtle);">
        <h1 class="type-h2" style="margin:0 0 12px;">{title}</h1>
        {description && <p class="type-lead" style="margin:0 0 12px;">{description}</p>}
        <div class="type-meta">By {author} · <time datetime={pubDate}>{pubDate}</time></div>
      </header>
      <article class="cs-prose">
        <Content />
      </article>
    </div>
  </main>
</Layout>

<style>
  .cs-prose { font-size: 1rem; line-height: 1.7; color: var(--cds-text-secondary); }
  .cs-prose :global(h2) { font-size: 1.5rem; font-weight: 400; color: var(--cds-text-primary); margin: 2rem 0 1rem; }
  .cs-prose :global(h3) { font-size: 1.2rem; font-weight: 600; color: var(--cds-text-primary); margin: 1.5rem 0 0.75rem; }
  .cs-prose :global(p) { margin: 0 0 1rem; }
  .cs-prose :global(a) { color: var(--cds-link-primary); }
  .cs-prose :global(code) { font-family: 'IBM Plex Mono', monospace; font-size: 0.875em; background: var(--cds-layer-01); padding: 2px 6px; }
  .cs-prose :global(pre) { background: var(--cds-layer-01); padding: 1rem; overflow-x: auto; }
</style>
