---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const highlights = [
  { value: '18 yrs', label: 'platform & developer documentation' },
  { value: '10', label: 'AI assistants shipped to a writing team' },
  { value: '80%', label: 'faster first drafts; 70% shorter reviews' },
  { value: '700+', label: 'DITA topics across 4 cloud product lines' },
];

const roles = [
  {
    title: 'Staff Technical Writer', company: 'Salesforce', dates: 'Jan 2025 – Present',
    points: [
      'Built ten production Slackbot AI skills for content writers using RAG, MCP, and agentic workflows, including Release Notes Assistant, Epic Analyzer, and Review Comment Resolver.',
      'Reduced first-draft time by 80% and review cycles by 70% through AI-powered documentation workflows; presented at Salesforce AI Expo.',
      'Led a documentation strategy adopted at VP level under a CEO-priority initiative, and delivered a Triage documentation framework validated at director level; led two senior writers and contractor teams.',
    ],
  },
  {
    title: 'Developer Experience Technical Writer', company: 'Intel Corporation', dates: 'Aug 2021 – Nov 2024',
    points: [
      'Led documentation for IoT, edge computing, and AI and ML platforms; authored Python code samples for AI SDK integrations and UI text aligned with Responsible AI guidelines.',
      'Reduced developer onboarding time by 25% through restructured API references and troubleshooting guides; managed a team of four writers and represented docs at VP and GM stakeholder reviews.',
    ],
  },
  {
    title: 'Senior Technical Writer', company: 'Rakuten', dates: 'Feb 2021 – Jul 2021',
    points: [
      'Created developer and DevOps documentation for Big Data platforms; collaborated with cross-functional teams on content strategy and UI copy standards.',
    ],
  },
  {
    title: 'Senior Technical Writer', company: 'Netcracker Technology', dates: 'Oct 2018 – Jan 2021',
    points: [
      'Managed documentation for cloud services and network management platforms, ensuring consistent delivery across multiple product lines.',
      'Aligned documentation with Google developer style guidelines and adopted docs-as-code workflows using Git and Confluence for version-controlled delivery.',
    ],
  },
];

const projects = [
  { title: 'DocPilot', body: 'Open-source Python docs pipeline with GitHub Actions CI/CD and multi-agent generation, built with Cursor and Claude Code.' },
  { title: 'Token Mastery', body: 'Self-paced LLM context-engineering course: 6 modules, 21 lessons, published as an interactive web app.' },
  { title: 'Custom MCP server', body: 'Personal AI knowledge base built on the Model Context Protocol.' },
];

const skills = [
  { group: 'AI & Knowledge Systems', items: 'RAG, MCP, agentic search, prompt engineering, HITL workflows, AI guardrails, LLM evaluation' },
  { group: 'Docs-as-Code', items: 'Git, GitHub Actions, CI/CD, Markdown, reStructuredText, Sphinx, AsciiDoc' },
  { group: 'Authoring', items: 'DITA, Oxygen XML, Arbortext, FrameMaker, Confluence, Swagger' },
  { group: 'Programming', items: 'Python, JavaScript, HTML, CSS, basic C/C++' },
  { group: 'Architecture', items: 'Taxonomy, metadata, single-source publishing, content governance' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kamal Raj — CV</title>
    <meta name="description" content="Curriculum vitae of Kamal Raj, Staff Technical Writer." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body { margin: 0; background: #E6DECF; font-family: 'Hanken Grotesk', system-ui, sans-serif; color: #1F1B16; -webkit-font-smoothing: antialiased; padding: 0 0 64px; }
      @page { size: A4; margin: 14mm 15mm; }
      @media print {
        body { background: #fff !important; }
        .cv-toolbar { display: none !important; }
        .cv-sheet { box-shadow: none !important; margin: 0 !important; width: auto !important; border-radius: 0 !important; }
        .cv-role { break-inside: avoid; }
      }
    </style>
  </head>
  <body>

    <div class="cv-toolbar" style="position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 24px;background:rgba(230,222,207,0.9);backdrop-filter:blur(10px);border-bottom:1px solid rgba(31,27,22,0.1);">
      <a href={`${base}/`} style="text-decoration:none;display:inline-flex;align-items:center;gap:8px;color:#5A5247;font-size:14px;font-weight:500;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Back to portfolio
      </a>
      <button id="cv-print" style="display:inline-flex;align-items:center;gap:8px;background:#B4471F;color:#F8F4EC;font-size:14px;font-weight:600;font-family:inherit;padding:10px 20px;border:none;border-radius:9px;cursor:pointer;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Download / Print PDF
      </button>
    </div>

    <div class="cv-sheet" style="width:210mm;max-width:calc(100% - 32px);margin:28px auto;background:#FFFFFF;box-shadow:0 12px 48px rgba(31,27,22,0.16);border-radius:3px;padding:18mm 16mm;box-sizing:border-box;">

      <header style="display:flex;justify-content:space-between;align-items:flex-start;gap:32px;padding-bottom:18px;border-bottom:2px solid #1F1B16;">
        <div>
          <h1 style="font-family:'Newsreader',serif;font-weight:500;font-size:38px;letter-spacing:-0.02em;line-height:1;margin:0 0 8px;">Kamal Raj</h1>
          <div style="font-size:14px;font-weight:600;letter-spacing:0.04em;color:#B4471F;text-transform:uppercase;">Staff Technical Writer</div>
          <div style="font-size:13px;color:#5A5247;margin-top:3px;">Platform Documentation · Developer Content Systems · AI Tooling</div>
        </div>
        <div style="text-align:right;font-size:12.5px;line-height:1.7;color:#3A332B;white-space:nowrap;">
          <div>kamal.raj2181@gmail.com</div>
          <div>+91 98806 77291</div>
          <div>linkedin.com/in/kamal-raj-75b389b</div>
        </div>
      </header>

      <section style="padding:18px 0;border-bottom:1px solid rgba(31,27,22,0.12);">
        <p style="font-family:'Newsreader',serif;font-size:15.5px;line-height:1.5;color:#2A241E;margin:0;font-style:italic;">
          Senior technical writer with 18 years across platform documentation, developer tooling, and AI-augmented content systems. I own developer documentation end to end for cloud and AI platforms, build docs-as-code pipelines, and most recently designed a suite of ten AI assistants that cut a writing team's first-draft time by 80%. Equal parts writer, information architect, and builder.
        </p>
      </section>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px 0;padding-top:16px;">

        <div style="grid-column:1 / -1;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(31,27,22,0.14);border-left:1px solid rgba(31,27,22,0.14);margin-bottom:18px;">
          {highlights.map(h => (
            <div style="padding:12px 14px;border-right:1px solid rgba(31,27,22,0.14);border-bottom:1px solid rgba(31,27,22,0.14);">
              <div style="font-family:'Newsreader',serif;font-size:26px;line-height:0.95;letter-spacing:-0.02em;">{h.value}</div>
              <div style="font-size:10.5px;color:#6B6358;margin-top:5px;line-height:1.3;">{h.label}</div>
            </div>
          ))}
        </div>

        <div style="grid-column:1 / -1;">
          <h2 style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#B4471F;margin:0 0 12px;">Experience</h2>
          {roles.map(r => (
            <div class="cv-role" style="display:grid;grid-template-columns:1fr auto;gap:8px 16px;padding:11px 0;border-bottom:1px solid rgba(31,27,22,0.1);">
              <div>
                <div style="font-family:'Newsreader',serif;font-weight:600;font-size:15.5px;letter-spacing:-0.01em;line-height:1.15;">{r.title}<span style="font-weight:400;color:#B4471F;"> · {r.company}</span></div>
              </div>
              <div style="font-size:12px;color:#5A5247;font-weight:500;text-align:right;white-space:nowrap;padding-top:2px;">{r.dates}</div>
              <ul style="grid-column:1 / -1;margin:7px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:4px;">
                {r.points.map(pt => (
                  <li style="position:relative;font-size:12.5px;line-height:1.45;color:#3A332B;padding-left:15px;">
                    <span style="position:absolute;left:0;top:7px;width:4px;height:4px;border-radius:50%;background:#B4471F;"></span>{pt}
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div style="font-size:11.5px;color:#8A8175;margin-top:9px;font-style:italic;font-family:'Newsreader',serif;">Earlier: Senior Technical Writer at AgilePoint (2017–2018) and Evolving Systems (2015–2016); Technical Writer at Novell Software Development (2014–2015) and Oracle India (2011–2014); Product Information Specialist at Unisys India (2010–2011); Technical Writer at Phantasm Games Studio (2008–2010).</div>
        </div>

        <div style="grid-column:1 / -1;display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:18px;">
          <div>
            <h2 style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#B4471F;margin:0 0 11px;">Independent Projects</h2>
            {projects.map(p => (
              <div style="margin-bottom:10px;">
                <div style="font-family:'Newsreader',serif;font-weight:600;font-size:13.5px;">{p.title}</div>
                <div style="font-size:12px;line-height:1.4;color:#5A5247;margin-top:1px;">{p.body}</div>
              </div>
            ))}
            <h2 style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#B4471F;margin:16px 0 9px;">Education</h2>
            <div style="font-family:'Newsreader',serif;font-weight:600;font-size:13.5px;">B.Tech, Mechanical Engineering</div>
            <div style="font-size:12px;color:#5A5247;margin-top:1px;">Cochin University of Science and Technology · 2000–2004</div>
          </div>

          <div>
            <h2 style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#B4471F;margin:0 0 11px;">Skills</h2>
            {skills.map(s => (
              <div style="margin-bottom:8px;">
                <div style="font-size:11px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:#1F1B16;margin-bottom:2px;">{s.group}</div>
                <div style="font-size:12px;line-height:1.45;color:#5A5247;">{s.items}</div>
              </div>
            ))}
            <h2 style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#B4471F;margin:14px 0 9px;">Certifications</h2>
            <div style="font-size:12px;line-height:1.5;color:#5A5247;">Generative AI for Business Leaders (LinkedIn, 2024) · Vibe Coding with Cursor AI (Scrimba, 2025) · Python for Machine Learning (IIT Roorkee, 2020) · Art of API Documentation (Udemy, 2020)</div>
          </div>
        </div>
      </div>
    </div>

    <script>
      const btn = document.getElementById('cv-print');
      if (btn) btn.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
