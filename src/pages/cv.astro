---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const highlights = [
  { value: '18 yrs', label: 'platform & developer documentation' },
  { value: '10', label: 'AI assistants shipped to a writing team' },
  { value: '80%', label: 'faster first drafts; 70% shorter reviews' },
  { value: '700+', label: 'DITA topics across 4 cloud product lines' },
];

const roles = [
  {
    title: 'Staff Technical Writer', company: 'Salesforce', dates: 'Jan 2025 – Present',
    points: [
      'Built ten production Slackbot AI skills for content writers using RAG, MCP, and agentic workflows, including Release Notes Assistant, Epic Analyzer, and Review Comment Resolver.',
      'Reduced first-draft time by 80% and review cycles by 70% through AI-powered documentation workflows; presented at Salesforce AI Expo.',
      'Led a documentation strategy adopted at VP level under a CEO-priority initiative, and delivered a Triage documentation framework validated at director level; led two senior writers and contractor teams.',
    ],
  },
  {
    title: 'Developer Experience Technical Writer', company: 'Intel Corporation', dates: 'Aug 2021 – Nov 2024',
    points: [
      'Led documentation for IoT, edge computing, and AI and ML platforms; authored Python code samples for AI SDK integrations and UI text aligned with Responsible AI guidelines.',
      'Reduced developer onboarding time by 25% through restructured API references and troubleshooting guides; managed a team of four writers and represented docs at VP and GM stakeholder reviews.',
    ],
  },
  {
    title: 'Senior Technical Writer', company: 'Rakuten', dates: 'Feb 2021 – Jul 2021',
    points: [
      'Created developer and DevOps documentation for Big Data platforms; collaborated with cross-functional teams on content strategy and UI copy standards.',
    ],
  },
  {
    title: 'Senior Technical Writer', company: 'Netcracker Technology', dates: 'Oct 2018 – Jan 2021',
    points: [
      'Managed documentation for cloud services and network management platforms, ensuring consistent delivery across multiple product lines.',
      'Aligned documentation with Google developer style guidelines and adopted docs-as-code workflows using Git and Confluence for version-controlled delivery.',
    ],
  },
];

const projects = [
  { title: 'DocPilot', body: 'Open-source Python docs pipeline with GitHub Actions CI/CD and multi-agent generation, built with Cursor and Claude Code.' },
  { title: 'Token Mastery', body: 'Self-paced LLM context-engineering course: 6 modules, 21 lessons, published as an interactive web app.' },
  { title: 'Custom MCP server', body: 'Personal AI knowledge base built on the Model Context Protocol.' },
];

const skills = [
  { group: 'AI & Knowledge Systems', items: 'RAG, MCP, agentic search, prompt engineering, HITL workflows, AI guardrails, LLM evaluation' },
  { group: 'Docs-as-Code', items: 'Git, GitHub Actions, CI/CD, Markdown, reStructuredText, Sphinx, AsciiDoc' },
  { group: 'Authoring', items: 'DITA, Oxygen XML, Arbortext, FrameMaker, Confluence, Swagger' },
  { group: 'Programming', items: 'Python, JavaScript, HTML, CSS, basic C/C++' },
  { group: 'Architecture', items: 'Taxonomy, metadata, single-source publishing, content governance' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kamal Raj — CV</title>
    <meta name="description" content="Curriculum vitae of Kamal Raj, Staff Technical Writer." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root { --ink: #161616; --sec: #525252; --help: #6f6f6f; --line: #e0e0e0; --blue: #0f62fe; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #f4f4f4; font-family: 'IBM Plex Sans', system-ui, sans-serif; color: var(--ink); -webkit-font-smoothing: antialiased; padding: 0 0 64px; }
      .mono { font-family: 'IBM Plex Mono', monospace; }

      .cv-toolbar { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 16px; background: rgba(244,244,244,0.94); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
      .cv-back { display: inline-flex; align-items: center; gap: 8px; color: var(--sec); font-size: 0.875rem; text-decoration: none; }
      .cv-back:hover { color: var(--ink); }
      .cv-print { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; background: var(--blue); color: #fff; border: none; border-radius: 0; font-family: inherit; font-size: 0.875rem; cursor: pointer; }
      .cv-print:hover { background: #0353e9; }

      .cv-sheet { width: 210mm; max-width: calc(100% - 24px); margin: 24px auto; background: #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.08); padding: 40px 32px; }
      @media (min-width: 672px) { .cv-sheet { padding: 18mm 16mm; } }

      .cv-header { display: flex; flex-direction: column; gap: 16px; padding-bottom: 16px; border-bottom: 2px solid var(--ink); }
      @media (min-width: 560px) { .cv-header { flex-direction: row; justify-content: space-between; align-items: flex-start; } }
      .cv-name { font-weight: 300; font-size: 2.25rem; letter-spacing: -0.02em; line-height: 1; margin: 0 0 8px; }
      .cv-role { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; color: var(--blue); text-transform: uppercase; }
      .cv-sub { font-size: 0.8125rem; color: var(--sec); margin-top: 3px; }
      .cv-contact { font-size: 0.8125rem; line-height: 1.7; color: var(--sec); }
      @media (min-width: 560px) { .cv-contact { text-align: right; } }

      .cv-summary { padding: 16px 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; line-height: 1.55; color: #393939; }

      .cv-highlights { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); border-left: 1px solid var(--line); margin: 16px 0 18px; }
      @media (min-width: 560px) { .cv-highlights { grid-template-columns: repeat(4, 1fr); } }
      .cv-hl { padding: 12px 14px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      .cv-hl-num { font-weight: 300; font-size: 1.5rem; line-height: 1; letter-spacing: -0.02em; }
      .cv-hl-label { font-size: 0.6875rem; color: var(--help); margin-top: 5px; line-height: 1.3; }

      .cv-h2 { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue); margin: 0 0 12px; }
      .cv-jobrow { display: grid; grid-template-columns: 1fr; gap: 2px; padding: 11px 0; border-bottom: 1px solid var(--line); break-inside: avoid; }
      @media (min-width: 560px) { .cv-jobrow { grid-template-columns: 1fr auto; align-items: baseline; } }
      .cv-jobtitle { font-weight: 600; font-size: 0.95rem; }
      .cv-jobtitle span { font-weight: 400; color: var(--blue); }
      .cv-jobdates { font-size: 0.75rem; color: var(--help); }
      @media (min-width: 560px) { .cv-jobdates { text-align: right; } }
      .cv-points { grid-column: 1 / -1; margin: 7px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
      .cv-points li { position: relative; font-size: 0.8125rem; line-height: 1.45; color: #393939; padding-left: 14px; }
      .cv-points li::before { content: ''; position: absolute; left: 0; top: 7px; width: 5px; height: 5px; background: var(--blue); }
      .cv-earlier { font-size: 0.75rem; color: var(--help); margin-top: 9px; }

      .cv-two { display: grid; grid-template-columns: 1fr; gap: 24px; margin-top: 18px; }
      @media (min-width: 560px) { .cv-two { grid-template-columns: 1fr 1fr; } }
      .cv-proj-t { font-weight: 600; font-size: 0.875rem; }
      .cv-proj-b { font-size: 0.8125rem; line-height: 1.4; color: var(--sec); margin-top: 1px; }
      .cv-skill-g { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 2px; }
      .cv-skill-i { font-size: 0.8125rem; line-height: 1.45; color: var(--sec); }

      @page { size: A4; margin: 14mm 15mm; }
      @media print {
        body { background: #fff !important; padding: 0; }
        .cv-toolbar { display: none !important; }
        .cv-sheet { box-shadow: none !important; margin: 0 !important; max-width: none !important; width: auto !important; padding: 0 !important; }
      }
    </style>
  </head>
  <body>

    <div class="cv-toolbar">
      <a href={`${base}/`} class="cv-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7M19 12H5"/></svg>
        Back to portfolio
      </a>
      <button id="cv-print" class="cv-print">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Download / Print PDF
      </button>
    </div>

    <div class="cv-sheet">
      <header class="cv-header">
        <div>
          <h1 class="cv-name">Kamal Raj</h1>
          <div class="cv-role">Staff Technical Writer</div>
          <div class="cv-sub">Platform Documentation · Developer Content Systems · AI Tooling</div>
        </div>
        <div class="cv-contact mono">
          <div>kamal.raj2181@gmail.com</div>
          <div>+91 98806 77291</div>
          <div>linkedin.com/in/kamal-raj-75b389b</div>
        </div>
      </header>

      <section class="cv-summary">
        Senior technical writer with 18 years across platform documentation, developer tooling, and AI-augmented content systems. I own developer documentation end to end for cloud and AI platforms, build docs-as-code pipelines, and most recently designed a suite of ten AI assistants that cut a writing team's first-draft time by 80%. Equal parts writer, information architect, and builder.
      </section>

      <div class="cv-highlights">
        {highlights.map(h => (
          <div class="cv-hl">
            <div class="cv-hl-num">{h.value}</div>
            <div class="cv-hl-label">{h.label}</div>
          </div>
        ))}
      </div>

      <section>
        <h2 class="cv-h2">Experience</h2>
        {roles.map(r => (
          <div class="cv-jobrow">
            <div class="cv-jobtitle">{r.title}<span> · {r.company}</span></div>
            <div class="cv-jobdates mono">{r.dates}</div>
            <ul class="cv-points">
              {r.points.map(pt => <li>{pt}</li>)}
            </ul>
          </div>
        ))}
        <div class="cv-earlier">Earlier: Senior Technical Writer at AgilePoint (2017–2018) and Evolving Systems (2015–2016); Technical Writer at Novell Software Development (2014–2015) and Oracle India (2011–2014); Product Information Specialist at Unisys India (2010–2011); Technical Writer at Phantasm Games Studio (2008–2010).</div>
      </section>

      <div class="cv-two">
        <div>
          <h2 class="cv-h2">Independent Projects</h2>
          {projects.map(p => (
            <div style="margin-bottom:10px;">
              <div class="cv-proj-t">{p.title}</div>
              <div class="cv-proj-b">{p.body}</div>
            </div>
          ))}
          <h2 class="cv-h2" style="margin-top:16px;">Education</h2>
          <div class="cv-proj-t">B.Tech, Mechanical Engineering</div>
          <div class="cv-proj-b">Cochin University of Science and Technology · 2000–2004</div>
        </div>
        <div>
          <h2 class="cv-h2">Skills</h2>
          {skills.map(s => (
            <div style="margin-bottom:8px;">
              <div class="cv-skill-g">{s.group}</div>
              <div class="cv-skill-i">{s.items}</div>
            </div>
          ))}
          <h2 class="cv-h2" style="margin-top:14px;">Certifications</h2>
          <div class="cv-skill-i">Generative AI for Business Leaders (LinkedIn, 2024) · Vibe Coding with Cursor AI (Scrimba, 2025) · Python for Machine Learning (IIT Roorkee, 2020) · Art of API Documentation (Udemy, 2020)</div>
        </div>
      </div>
    </div>

    <script>
      const btn = document.getElementById('cv-print');
      if (btn) btn.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
