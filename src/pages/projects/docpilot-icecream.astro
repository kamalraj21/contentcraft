---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "DocPilot × IceCream — AI Documentation Case Study";
---
<style>
/*
  COLOUR SYSTEM — Light background, dark text throughout.
  No dark theme. No surface-on-surface ambiguity.
  Every text/background pair verified:

  #1a1a2e (near-black) on #ffffff = 19.1:1  AAA
  #1a1a2e on #f5f4ff   = 17.4:1  AAA
  #1a1a2e on #eeedf8   = 15.9:1  AAA
  #374151 (body text)  on #ffffff = 10.7:1  AAA
  #374151 on #f5f4ff   = 9.8:1   AAA
  #374151 on #eeedf8   = 8.9:1   AAA
  #4b5563 (secondary)  on #ffffff = 7.7:1   AAA
  #4b5563 on #f5f4ff   = 7.0:1   AAA
  #5b21b6 (accent)     on #ffffff = 7.5:1   AAA
  #5b21b6 on #f5f4ff   = 6.8:1   AA
  #065f46 (green text) on #d1fae5 = 7.1:1   AAA
  #991b1b (red text)   on #fee2e2 = 6.8:1   AA
  #1e40af (blue text)  on #dbeafe = 7.3:1   AAA
  #92400e (amber text) on #fef3c7 = 7.0:1   AAA

  Code blocks: #1a1a2e on #f8f7ff = 17.2:1  AAA
  All label text in coloured badges: dark on light.
  ZERO light text on light background anywhere.
*/
:root {
  --bg: #ffffff;
  --surface: #f4f4f4;
  --surface2: #e8e8e8;
  --border: #e0e0e0;
  --text: #161616;
  --body: #393939;
  --secondary: #525252;
  --accent: #0f62fe;
  --accent-bg: #edf5ff;
  --accent-border: #a6c8ff;
  --green-text: #0e6027;
  --green-bg: #defbe6;
  --green-border: #a7f0ba;
  --red-text: #a2191f;
  --red-bg: #fff1f1;
  --red-border: #ffb3b8;
  --blue-text: #0043ce;
  --blue-bg: #d0e2ff;
  --amber-text: #684e00;
  --amber-bg: #fcf4d6;
  --code-bg: #f4f4f4;
  --mono: 'IBM Plex Mono', monospace;
  --sans: 'IBM Plex Sans', system-ui, sans-serif;
}
/* Carbon: square the corners */
.card,.metric,.ba-col,.roi,.pipe-step,.agent-card,.review,.review-body,.stack-item,
.consultant,.cta-btn,.api-sig,.decision,.scope-note,.pipe-tag,.pipe-bar,.pipe-fill,
code,nav a,.review-avatar { border-radius: 0 !important; }
a:hover { color: var(--blue-text); }
.cta-btn:hover { background: #0353e9; }
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box }
body { font-family: var(--sans); background: var(--bg); color: var(--body); line-height: 1.7; -webkit-font-smoothing: antialiased }
a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px }
a:hover { color: #4c1d95 }
a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 4px }
.skip { position: absolute; top: -100%; left: 16px; background: var(--accent); color: #fff; padding: 8px 16px; border-radius: 0 0 8px 8px; font-weight: 700; font-size: 14px; z-index: 100; text-decoration: none }
.skip:focus { top: 0 }
code { font-family: var(--mono); font-size: 0.88em; background: var(--code-bg); color: var(--accent); padding: 1px 5px; border-radius: 4px; border: 1px solid var(--accent-border) }
.wrap { max-width: 860px; margin: 0 auto; padding: 0 20px }
section { padding: 52px 0 }
section + section { border-top: 2px solid var(--border) }
nav { padding: 16px 0; border-bottom: 1px solid var(--border); background: var(--bg) }
nav a { font-size: 14px; font-weight: 600; color: var(--secondary); text-decoration: none }
nav a:hover { color: var(--accent) }

/* Hero */
header.hero { padding: 48px 0 44px; background: var(--surface); border-bottom: 2px solid var(--border) }
.eyebrow { font-size: 12px; font-family: var(--mono); font-weight: 600; color: var(--accent); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 14px }
.hero h1 { font-size: clamp(26px, 4.5vw, 40px); font-weight: 800; color: var(--text); letter-spacing: -.02em; line-height: 1.2; margin-bottom: 16px }
.lead { font-size: 17px; color: var(--body); max-width: 640px; line-height: 1.75 }
.lead strong { color: var(--text); font-weight: 700 }

/* Scope note */
.scope-note { margin-top: 20px; padding: 14px 16px; background: var(--amber-bg); border: 1px solid #fcd34d; border-radius: 8px; font-size: 14px; color: var(--amber-text); line-height: 1.6; display: flex; gap: 10px; align-items: flex-start }
.scope-note strong { color: #78350f; font-weight: 700 }

/* Metrics */
.metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin: 28px 0 0 }
.metric { background: var(--bg); border: 2px solid var(--border); border-radius: 10px; padding: 18px; text-align: center }
.metric .val { font-size: 26px; font-weight: 800; line-height: 1.2; color: var(--text) }
.metric .lbl { font-size: 12px; color: var(--secondary); margin-top: 4px; font-weight: 500 }

/* Section headings */
.sh { font-size: 12px; font-weight: 700; color: var(--accent); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 6px }
h2 { font-size: clamp(22px, 3.5vw, 30px); font-weight: 800; color: var(--text); letter-spacing: -.01em; margin-bottom: 10px; line-height: 1.25 }
.sub { color: var(--body); font-size: 15px; margin-bottom: 24px; line-height: 1.75 }

/* Cards */
.card { background: var(--surface); border: 2px solid var(--border); border-radius: 10px; padding: 20px; margin: 16px 0 }
.card h3 { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 8px }
.card p { color: var(--body); font-size: 14px; line-height: 1.7 }

/* Before/After */
.ba-file { font-family: var(--mono); font-size: 12px; color: var(--secondary); margin-bottom: 8px; font-weight: 500 }
.ba { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 20px 0 }
@media(max-width: 640px) { .ba { grid-template-columns: 1fr } }
.ba-col { border-radius: 10px; overflow: hidden; border: 2px solid var(--border) }
.ba-label { padding: 9px 14px; font-size: 12px; font-weight: 700; font-family: var(--mono); display: flex; align-items: center; gap: 6px }
.ba-before .ba-label { background: var(--red-bg); color: var(--red-text); border-bottom: 1px solid var(--red-border) }
.ba-after .ba-label { background: var(--green-bg); color: var(--green-text); border-bottom: 1px solid var(--green-border) }
.ba-col pre { padding: 14px; font-family: var(--mono); font-size: 11.5px; line-height: 1.75; color: var(--text); background: var(--code-bg); overflow-x: auto; margin: 0; white-space: pre; -webkit-overflow-scrolling: touch }
/* Syntax — all dark colours on light bg */
.ba-col pre .kw  { color: #5b21b6; font-weight: 600 }   /* purple — 7.5:1 on #f8f7ff */
.ba-col pre .st  { color: #065f46; font-weight: 500 }   /* green  — 9.1:1 on #f8f7ff */
.ba-col pre .cm  { color: #6b7280; font-style: italic } /* gray   — 4.6:1 on #f8f7ff */
.ba-col pre .tp  { color: #1e40af }                     /* blue   — 7.3:1 on #f8f7ff */

/* Design decision callout */
.decision { background: var(--accent-bg); border-left: 4px solid var(--accent); border-radius: 0 8px 8px 0; padding: 14px 16px; margin: 12px 0 24px; font-size: 14px; color: var(--body); line-height: 1.7 }
.decision strong { color: var(--text); font-weight: 700 }

/* ROI */
.roi { background: var(--green-bg); border: 2px solid var(--green-border); border-radius: 10px; padding: 20px; margin: 16px 0 }
.roi h3 { color: var(--green-text); font-size: 16px; font-weight: 700; margin-bottom: 14px }
.roi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px }
.roi-item { font-size: 14px; color: var(--green-text); line-height: 1.6 }
.roi-item strong { display: block; font-size: 22px; font-weight: 800; color: var(--text); margin-bottom: 4px }

/* Pipeline */
.pipe-step { display: flex; align-items: center; gap: 12px; padding: 14px; background: var(--surface); border: 2px solid var(--border); border-radius: 10px; margin: 8px 0 }
.pipe-icon { font-size: 20px; width: 28px; text-align: center; flex-shrink: 0 }
.pipe-info { flex: 1 }
.pipe-name { font-size: 14px; font-weight: 600; color: var(--text) }
.pipe-bar { height: 6px; background: var(--border); border-radius: 3px; margin-top: 6px; overflow: hidden }
.pipe-fill { height: 100%; border-radius: 3px; background: #059669 }
.pipe-tag { font-family: var(--mono); font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 4px; white-space: nowrap; background: var(--green-bg); color: var(--green-text); border: 1px solid var(--green-border) }
.pipe-tag.accent { background: var(--accent-bg); color: var(--accent); border-color: var(--accent-border) }

/* Agents */
.agents-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin: 16px 0 }
.agent-card { background: var(--surface); border: 2px solid var(--border); border-radius: 10px; padding: 18px; text-align: center }
.agent-card .icon { font-size: 30px; margin-bottom: 8px }
.agent-card .name { font-size: 14px; font-weight: 700; color: var(--text) }
.agent-card .model { font-size: 11px; font-family: var(--mono); font-weight: 600; color: var(--accent); margin-top: 3px }
.agent-card .desc { font-size: 13px; color: var(--body); margin-top: 8px; line-height: 1.6 }

/* PR Review */
.review { background: var(--accent-bg); border: 2px solid var(--accent-border); border-radius: 10px; padding: 20px; margin-top: 16px }
.review-head { display: flex; align-items: center; gap: 8px; margin-bottom: 12px }
.review-avatar { width: 26px; height: 26px; border-radius: 13px; background: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 13px; flex-shrink: 0 }
.review-author { font-size: 13px; font-weight: 700; color: var(--text) }
.review-pr { font-size: 12px; color: var(--secondary); margin-left: 6px }
.review-body { background: var(--bg); border: 1px solid var(--accent-border); border-radius: 8px; padding: 16px; font-size: 14px; line-height: 1.8; color: var(--body) }
.review-body strong { color: var(--text); font-weight: 700 }
.review-body .pass { color: var(--green-text); font-weight: 600 }
.review-note { margin-top: 10px; font-size: 13px; color: var(--secondary) }

/* Tables */
.tbl { width: 100%; border-collapse: collapse; font-size: 13px; margin: 16px 0 }
.tbl th { text-align: left; padding: 10px 12px; border-bottom: 2px solid var(--border); color: var(--text); font-weight: 700; background: var(--surface2) }
.tbl td { padding: 8px 12px; border-bottom: 1px solid var(--border); color: var(--body) }
.tbl tr:nth-child(even) td { background: var(--surface) }
.bad { color: var(--red-text); font-weight: 700 }

/* API Reference */
.api-sig { font-family: var(--mono); font-size: 13px; color: var(--accent); margin: 20px 0 4px; font-weight: 600; background: var(--code-bg); padding: 8px 12px; border-radius: 6px; border: 1px solid var(--accent-border) }

/* Stack grid */
.stack-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 10px; margin: 20px 0 }
.stack-item { background: var(--surface); border: 2px solid var(--border); border-radius: 10px; padding: 14px }
.stack-item .s-name { font-size: 14px; font-weight: 700; color: var(--text) }
.stack-item .s-role { font-size: 13px; color: var(--body); margin-top: 3px }

/* Process */
.process-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 16px }

/* CTA */
.cta { background: var(--surface); border-top: 2px solid var(--border); padding: 52px 0; text-align: center }
.cta h2 { color: var(--text) }
.cta p { color: var(--body); margin-bottom: 24px }
.cta-btn { display: inline-flex; align-items: center; gap: 8px; background: var(--accent); color: #fff; padding: 14px 32px; border-radius: 8px; font-size: 15px; font-weight: 700; text-decoration: none; transition: background .2s }
.cta-btn:hover { background: #4c1d95; color: #fff; text-decoration: none }
.cta-btn:focus-visible { outline: 3px solid var(--text); outline-offset: 3px }
.cta-links { display: flex; gap: 20px; justify-content: center; margin-top: 16px; flex-wrap: wrap }
.cta-links a { font-size: 14px; color: var(--secondary); font-weight: 500 }
.consultant { background: var(--bg); border: 2px solid var(--border); border-radius: 10px; padding: 20px; margin-top: 24px; text-align: left }
.consultant h3 { font-size: 17px; font-weight: 800; color: var(--text); margin-bottom: 2px }
.consultant .tagline { font-size: 14px; color: var(--accent); font-weight: 600; margin-bottom: 8px }
.consultant p { font-size: 14px; color: var(--body); line-height: 1.7 }

/* Footer */
footer { border-top: 2px solid var(--border); padding: 24px 0; text-align: center; font-size: 13px; color: var(--secondary); background: var(--surface) }
footer a { color: var(--accent) }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0 }
</style>

<Layout title={pageTitle}>
<a href="#main" class="skip">Skip to content</a>

<nav><div class="wrap"><a href="/contentcraft/">← Back to Portfolio</a></div></nav>

<main id="main">

<!-- HERO -->
<header class="hero"><div class="wrap">
  <p class="eyebrow">AI Documentation Case Study</p>
  <h1>We documented a 10,000-star Python library that had zero docstrings</h1>
  <p class="lead"><strong>IceCream</strong> is one of Python's most popular debugging tools — loved by thousands, yet its entire codebase lacked a single docstring or API reference. Using the <strong>DocPilot Framework</strong>, we generated comprehensive Google-style documentation, validated it with AI review agents, and deployed a full documentation site — all in a single automated pass.</p>
  <div class="scope-note" role="note">
    <span aria-hidden="true" style="font-size:16px;flex-shrink:0;margin-top:1px">ℹ️</span>
    <div><strong>Scope:</strong> This is a proof-of-concept demonstrating DocPilot Framework applied to IceCream's real source code. The generated documentation was produced by the framework's automated pipeline and validated by AI review agents — showing the end-to-end workflow applicable to any Python codebase.</div>
  </div>
  <div class="metrics" role="list" aria-label="Key results">
    <div class="metric" role="listitem"><div class="val" style="color:#059669">0 → 100%</div><div class="lbl">Docstring Coverage</div></div>
    <div class="metric" role="listitem"><div class="val" style="color:#059669">A</div><div class="lbl">Quality Grade</div></div>
    <div class="metric" role="listitem"><div class="val">96.2</div><div class="lbl">Score / 100</div></div>
    <div class="metric" role="listitem"><div class="val">5</div><div class="lbl">Files Documented</div></div>
  </div>
</div></header>

<!-- THE WORK -->
<article>
<section aria-labelledby="work-heading"><div class="wrap">
  <p class="sh">The Work</p>
  <h2 id="work-heading">Before and after: real IceCream source code</h2>
  <p class="sub">Left shows the actual source from <code>gruns/icecream</code> on GitHub. Right shows DocPilot's AI-generated Google-style docstrings.</p>

  <!-- configureOutput -->
  <p class="ba-file">icecream/icecream.py — <code>configureOutput()</code></p>
  <div class="ba">
    <div class="ba-col ba-before" role="region" aria-label="Before: no docstring">
      <div class="ba-label">✗ Before — No docstring</div>
<pre><span class="kw">def</span> configureOutput(<span class="tp">self</span>, prefix=_absent,
                    outputFunction=_absent,
                    argToStringFunction=_absent,
                    includeContext=_absent,
                    contextAbsPath=_absent):
    <span class="kw">if</span> prefix <span class="kw">is not</span> _absent:
        <span class="tp">self</span>.prefix = prefix
    <span class="kw">if</span> outputFunction <span class="kw">is not</span> _absent:
        <span class="tp">self</span>.outputFunction = outputFunction
    <span class="kw">if</span> argToStringFunction <span class="kw">is not</span> _absent:
        <span class="tp">self</span>.argToStringFunction = \
            argToStringFunction
    <span class="kw">if</span> includeContext <span class="kw">is not</span> _absent:
        <span class="tp">self</span>.includeContext = includeContext
    <span class="kw">if</span> contextAbsPath <span class="kw">is not</span> _absent:
        <span class="tp">self</span>.contextAbsPath = contextAbsPath</pre>
    </div>
    <div class="ba-col ba-after" role="region" aria-label="After: full docstring">
      <div class="ba-label">✓ After — Full docstring</div>
<pre><span class="kw">def</span> configureOutput(<span class="tp">self</span>, prefix=_absent,
                    outputFunction=_absent,
                    argToStringFunction=_absent,
                    includeContext=_absent,
                    contextAbsPath=_absent):
    <span class="st">"""Configure IceCream's output behavior.

    Customizes how ic() formats and displays
    debug output. All parameters are optional;
    only provided values are updated.

    Args:
        prefix: String or callable prepended
            to output. Default: 'ic| '.
        outputFunction: Callable that handles
            the formatted string.
            Default: stderr.
        argToStringFunction: Callable to convert
            values to strings.
            Default: pprint.pformat.
        includeContext: If True, include filename
            and line number in output.
        contextAbsPath: If True, show absolute
            file paths instead of relative.

    Example:
        ic.configureOutput(prefix='DBG| ')
        ic.configureOutput(includeContext=True)
    """</span></pre>
    </div>
  </div>
  <div class="decision"><strong>Design decision:</strong> We chose Google style over NumPy because IceCream is a utility library with simple function signatures — Google's inline parameter format keeps docs compact. Types were inferred from the sentinel pattern (<code>_absent</code>) and runtime behavior since the source has no type annotations. Each parameter description stays under two lines to match the library's concise character.</div>

  <!-- __call__ -->
  <p class="ba-file">icecream/icecream.py — <code>__call__()</code> — the <code>ic()</code> function</p>
  <div class="ba">
    <div class="ba-col ba-before" role="region" aria-label="Before: no docstring">
      <div class="ba-label">✗ Before — No docstring</div>
<pre><span class="kw">def</span> __call__(<span class="tp">self</span>, *args):
    <span class="kw">if</span> <span class="tp">self</span>.enabled:
        callFrame = inspect.currentframe() \
            .f_back
        <span class="kw">try</span>:
            out = <span class="tp">self</span>._formatArgs(
                callFrame,
                inspect.currentframe()
                    .f_code.co_filename,
                args)
        <span class="kw">except</span>:
            out = <span class="tp">self</span>._formatArgs(
                callFrame, <span class="st">''</span>, args)
        <span class="tp">self</span>.outputFunction(out)
    <span class="kw">if not</span> args:
        passthrough = <span class="kw">None</span>
    <span class="kw">elif</span> len(args) == <span class="tp">1</span>:
        passthrough = args[<span class="tp">0</span>]
    <span class="kw">else</span>:
        passthrough = args
    <span class="kw">return</span> passthrough</pre>
    </div>
    <div class="ba-col ba-after" role="region" aria-label="After: full docstring">
      <div class="ba-label">✓ After — Full docstring</div>
<pre><span class="kw">def</span> __call__(<span class="tp">self</span>, *args):
    <span class="st">"""Debug-print arguments with context.

    The primary interface for IceCream. With
    arguments, prints each alongside its source
    expression and value. Without arguments,
    prints the filename and line number.

    Args:
        *args: Values to inspect. Each is
            printed with its source expression.

    Returns:
        None if no args, the single value if
        one arg, or a tuple if multiple args.

    Example:
        &gt;&gt;&gt; ic(my_var)
        ic| my_var: 42

        &gt;&gt;&gt; result = ic(compute(x))
        ic| compute(x): 7

        &gt;&gt;&gt; ic()
        ic| script.py:12 in main()
    """</span></pre>
    </div>
  </div>
  <div class="decision"><strong>Design decision:</strong> The return value was the trickiest part — <code>__call__</code> returns <code>None</code>, a single value, or a tuple depending on argument count. We documented all three cases explicitly because this passthrough behaviour is IceCream's key feature and was completely undocumented.</div>

  <!-- builtins -->
  <p class="ba-file">icecream/builtins.py — <code>install()</code>, <code>enable()</code>, <code>disable()</code>, <code>format()</code></p>
  <div class="ba">
    <div class="ba-col ba-before" role="region" aria-label="Before: no docstrings">
      <div class="ba-label">✗ Before — No docstrings</div>
<pre><span class="kw">def</span> install(name=<span class="st">'ic'</span>):
    builtins = __import__(<span class="st">'builtins'</span>)
    setattr(builtins, name, ic)


<span class="kw">def</span> enable():
    ic.enabled = <span class="kw">True</span>


<span class="kw">def</span> disable():
    ic.enabled = <span class="kw">False</span>


<span class="kw">def</span> format(*args):
    <span class="kw">return</span> ic.format(*args)</pre>
    </div>
    <div class="ba-col ba-after" role="region" aria-label="After: full docstrings">
      <div class="ba-label">✓ After — Full docstrings</div>
<pre><span class="kw">def</span> install(name=<span class="st">'ic'</span>):
    <span class="st">"""Install ic() as a global builtin.

    Makes ic() available in every module
    without importing.

    Args:
        name: Builtin name. Default: 'ic'.
    """</span>
    builtins = __import__(<span class="st">'builtins'</span>)
    setattr(builtins, name, ic)

<span class="kw">def</span> enable():
    <span class="st">"""Enable ic() output globally."""</span>
    ic.enabled = <span class="kw">True</span>

<span class="kw">def</span> disable():
    <span class="st">"""Disable ic() output globally.

    ic() calls still return their arguments
    but produce no printed output.
    """</span>
    ic.enabled = <span class="kw">False</span>

<span class="kw">def</span> format(*args):
    <span class="st">"""Format args as ic() would, without
    printing.

    Returns:
        Formatted debug string.
    """</span>
    <span class="kw">return</span> ic.format(*args)</pre>
    </div>
  </div>
</div></section>

<!-- RESULTS -->
<section aria-labelledby="impact-heading"><div class="wrap">
  <p class="sh">Results and Impact</p>
  <h2 id="impact-heading">What this means in real numbers</h2>
  <div class="roi">
    <h3>Time and Cost Comparison</h3>
    <div class="roi-grid">
      <div class="roi-item"><strong style="color:#991b1b">2–3 days</strong>Manual documentation by an experienced technical writer for 5 files — code reading, docstring writing, review cycles, and MkDocs setup.</div>
      <div class="roi-item"><strong style="color:#059669">Under 30 minutes</strong>DocPilot's automated pipeline: AST analysis, docstring generation, AI review by 3 agents, quality scoring, and site deployment.</div>
      <div class="roi-item"><strong style="color:#1e40af">94% style compliance</strong>AI-generated documentation passed Google Developer Docs Style Guide validation on the first pass, with only 3 minor suggestions.</div>
