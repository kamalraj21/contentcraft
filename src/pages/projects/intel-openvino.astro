---
import CaseStudy from '../../layouts/CaseStudy.astro';

const sections = [
  {
    id: 'scope', label: 'The challenge',
    heading: 'Two toolchains, two platforms, one developer journey',
    intro: 'OpenVINO and Tiber Edge AI serve distinct deployment environments, cloud edge and on-device, with overlapping but not identical developer audiences. Each toolchain has its own model conversion pipeline, inference engine API, and deployment workflow.',
    blocks: [
      { type: 'para', text: 'The documentation challenge was maintaining a coherent developer journey across both platforms without duplicating content or creating navigation dead-ends for developers who needed to move between toolchains.' },
      { type: 'cards', items: [
        { title: 'OpenVINO toolkit', body: 'Model optimization and inference for Intel hardware: install, model conversion, inference API, deployment walkthroughs.' },
        { title: 'Tiber Edge AI', body: 'On-device AI platform documentation covering the edge deployment pipeline and platform-specific APIs.' },
        { title: 'Cross-platform IA', body: 'Unified information architecture and navigation serving developers across both toolchains.' },
      ]},
    ],
  },
  {
    id: 'approach', label: 'The approach',
    heading: 'Full information architecture ownership',
    intro: 'Owned the complete documentation stack, not just writing, but the architecture that determined how content was structured, versioned, and published across both platforms.',
    blocks: [
      { type: 'steps', items: [
        { n: '01', title: 'Topic taxonomy and navigation', points: ['Designed the information architecture from the ground up: topic hierarchy, cross-references, and navigation that served both beginner and expert developer paths.'] },
        { n: '02', title: 'Versioning strategy', points: ['Built a versioning approach that kept multiple OpenVINO releases accurate and navigable without creating maintenance overhead.'] },
        { n: '03', title: 'Doc toolchain', points: ['Owned the Sphinx-based build and publish pipeline running on GitHub Actions: responsible for both the content and the system that delivered it.'] },
        { n: '04', title: 'Core developer guides', points: ['Wrote and maintained install guides, model conversion walkthroughs, inference engine API references, and deployment documentation across release cycles.'] },
      ]},
    ],
  },
  {
    id: 'architecture', label: 'Architecture',
    heading: 'Documentation as a system',
    blocks: [
      { type: 'cards', items: [
        { title: 'DITA-based structure', body: 'Topic-based authoring with structured reuse across overlapping content between the two platforms.' },
        { title: 'CI/CD publishing', body: 'GitHub Actions pipeline building and deploying docs on every merge: documentation treated as a software artifact.' },
        { title: 'Multi-audience IA', body: 'Separate entry points and progressive disclosure for developers new to edge AI versus experienced OpenVINO users.' },
      ]},
    ],
  },
  {
    id: 'insights', label: 'What it shows',
    heading: 'What this project demonstrates',
    blocks: [
      { type: 'list', items: [
        'Owning the toolchain is as important as owning the content. A well-architected build pipeline keeps documentation accurate across release cycles without heroic manual effort.',
        'Cross-platform documentation requires explicit architectural decisions, not just good writing. Navigation structure determines whether developers find what they need.',
        'DITA topic-based authoring pays dividends when content overlaps across platforms: structured reuse prevents drift between parallel documentation sets.',
      ]},
    ],
  },
];
---

<CaseStudy
  title="Intel OpenVINO Developer Docs"
  description="Developer documentation for Intel's OpenVINO toolkit and Tiber Edge AI platform: two inference toolchains, full developer journey from install to production."
  kicker="Technical Writing · Information Architecture"
  org="Intel"
  date="2021–2023"
  lead="Owned developer documentation for the OpenVINO and Tiber Edge AI platforms: two inference toolchains, two deployment environments, covering the full developer journey from install to production."
  metrics={[
    { value: '2', label: 'Inference toolchains documented' },
    { value: '2', label: 'AI platforms covered' },
    { value: 'End-to-end', label: 'Developer journey ownership' },
  ]}
  tech={['DITA', 'Sphinx', 'reStructuredText', 'GitHub Actions', 'OpenVINO']}
  sections={sections}
/>
