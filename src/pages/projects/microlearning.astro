---
import CaseStudy from '../../layouts/CaseStudy.astro';

const sections = [
  {
    id: 'challenge', label: 'The challenge',
    heading: 'Turning dense docs into learning that sticks',
    intro: 'Transform complex technical documentation into bite-sized, engaging learning experiences that increase retention and accelerate developer onboarding while maintaining technical accuracy.',
    blocks: [
      { type: 'list', items: [
        'Dense technical content overwhelming users.',
        'Long onboarding time for new developers.',
        'Low completion rates for documentation.',
        'Poor information retention rates.',
      ]},
    ],
  },
  {
    id: 'strategy', label: 'The approach',
    heading: 'A modular, interactive learning framework',
    blocks: [
      { type: 'steps', items: [
        { n: '01', title: 'Learning pattern analysis', points: ['Analyzed developer learning patterns and identified key friction points in the documentation journey through comprehensive user research.'] },
        { n: '02', title: 'Content architecture', points: ['Developed a modular content framework that breaks complex topics into digestible, interconnected learning units.'] },
        { n: '03', title: 'Interactive components', points: ['Created interactive code examples and hands-on exercises to reinforce learning and improve engagement.'] },
        { n: '04', title: 'Progressive learning path', points: ['Implemented adaptive learning paths that adjust to user proficiency levels and learning preferences.'] },
      ]},
    ],
  },
  {
    id: 'results', label: 'The outcome',
    heading: 'Faster onboarding, better retention',
    blocks: [
      { type: 'metrics', items: [
        { value: '50%', label: 'Less learning time', detail: 'Reduction in time-to-competency through focused learning modules.' },
        { value: '85%', label: 'Info retention', detail: 'Improvement in knowledge retention through interactive learning.' },
        { value: '3x', label: 'Engagement', detail: 'Increase in documentation engagement and completion rates.' },
      ]},
    ],
  },
  {
    id: 'insights', label: 'What it shows',
    heading: 'Key learnings',
    blocks: [
      { type: 'list', items: [
        'Breaking complex information into digestible chunks significantly improves learning outcomes.',
        'Interactive elements and practical examples increase engagement and retention.',
        'Personalized learning paths cater to different learning styles and expertise levels.',
        'Regular feedback loops are essential for continuous content improvement.',
      ]},
    ],
  },
];
---

<CaseStudy
  title="Microlearning at Intel"
  description="Transforming dense technical documentation into bite-sized interactive modules, cutting learning time by 50% while improving retention."
  kicker="Learning Design · Content Strategy"
  org="Intel Corporation"
  date="2021–2022"
  lead="Transformed complex technical documentation into bite-sized, engaging learning experiences that cut learning time by 50% and improved retention."
  metrics={[
    { value: '50%', label: 'Less learning time' },
    { value: '85%', label: 'Info retention' },
    { value: '3x', label: 'Engagement' },
  ]}
  tech={['Learning Design', 'Content Strategy', 'DITA', 'Interactive Modules']}
  sections={sections}
/>
