---
import '../styles/carbon.css';
interface Props { title: string; description?: string; }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://kamalraj21.github.io').href} />
    <meta name="theme-color" content="#0f62fe" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={new URL(Astro.url.pathname, 'https://kamalraj21.github.io').href} />
    <meta property="og:image" content="https://kamalraj21.github.io/contentcraft/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content="https://kamalraj21.github.io/contentcraft/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#work" class="kr-skip">Skip to content</a>

    <header id="kr-header" class="kr-header">
      <div class="kr-header__inner">
        <a href={`${base}/`} class="kr-brand">
          <span class="kr-brand__name">Kamal Raj</span>
          <span class="kr-brand__tag">Content &amp; AI</span>
        </a>

        <nav class="kr-nav" id="kr-nav" aria-label="Primary">
          <a href={`${base}/#work`} class="kr-nav__link">Work</a>
          <a href={`${base}/#about`} class="kr-nav__link">About</a>
          <a href={`${base}/#experience`} class="kr-nav__link">Experience</a>
          <a href={`${base}/blog/`} class="kr-nav__link">Writing</a>
          <a href={`${base}/#contact`} class="kr-nav__link">Contact</a>
          <a href={`${base}/cv`} class="btn btn--primary kr-nav__cta">
            Download CV
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17V3"/><path d="m6 11 6 6 6-6"/><path d="M19 21H5"/></svg>
          </a>
        </nav>

        <button id="kr-menu-btn" class="kr-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="kr-mobile">
          <svg class="kr-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          <svg class="kr-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none;"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <div id="kr-mobile" class="kr-mobile" hidden>
        <a href={`${base}/#work`} class="kr-mobile__link">Work</a>
        <a href={`${base}/#about`} class="kr-mobile__link">About</a>
        <a href={`${base}/#experience`} class="kr-mobile__link">Experience</a>
        <a href={`${base}/blog/`} class="kr-mobile__link">Writing</a>
        <a href={`${base}/#contact`} class="kr-mobile__link">Contact</a>
        <a href={`${base}/cv`} class="kr-mobile__link kr-mobile__cta">Download CV</a>
      </div>
    </header>

    <slot />

    <style>
      .kr-skip { position: absolute; left: 16px; top: -100%; z-index: 200; background: var(--cds-interactive); color: #fff; padding: 10px 18px; font-size: 0.875rem; text-decoration: none; }
      .kr-skip:focus { top: 0; }
      .kr-header {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        background: rgba(255,255,255,0.92); backdrop-filter: blur(8px);
        border-bottom: 1px solid transparent;
        transition: border-color 200ms var(--cds-ease-productive);
      }
      .kr-header.is-scrolled { border-bottom-color: var(--cds-border-subtle); }
      .kr-header__inner {
        max-width: var(--cds-container); margin: 0 auto;
        display: flex; align-items: center; justify-content: space-between;
        height: 48px; padding: 0 16px;
      }
      @media (min-width: 672px) { .kr-header__inner { padding: 0 32px; height: 56px; } }
      @media (min-width: 1056px) { .kr-header__inner { padding: 0 40px; } }

      .kr-brand { display: flex; align-items: baseline; gap: 10px; text-decoration: none; color: var(--cds-text-primary); }
      .kr-brand__name { font-weight: 600; font-size: 1rem; letter-spacing: 0; }
      .kr-brand__tag { font-family: 'IBM Plex Mono', monospace; font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cds-text-helper); }

      .kr-nav { display: none; align-items: center; gap: 4px; }
      .kr-nav__link { font-size: 0.875rem; color: var(--cds-text-secondary); text-decoration: none; padding: 8px 12px; transition: color 110ms; }
      .kr-nav__link:hover { color: var(--cds-text-primary); }
      .kr-nav__cta { margin-left: 12px; min-height: 40px; }
      @media (min-width: 1056px) { .kr-nav { display: flex; } }

      .kr-menu-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; background: transparent; border: none; color: var(--cds-text-primary); cursor: pointer; margin-right: -12px; }
      @media (min-width: 1056px) { .kr-menu-btn { display: none; } }

      .kr-mobile { border-top: 1px solid var(--cds-border-subtle); background: #fff; padding: var(--sp-03) 0; }
      .kr-mobile__link { display: block; padding: 14px 16px; font-size: 1rem; color: var(--cds-text-primary); text-decoration: none; border-bottom: 1px solid var(--cds-border-subtle); }
      @media (min-width: 672px) { .kr-mobile__link { padding: 14px 32px; } }
      .kr-mobile__link:last-child { border-bottom: none; }
      .kr-mobile__cta { color: var(--cds-link-primary); font-weight: 600; }
    </style>

    <script>
      const header = document.getElementById('kr-header');
      const onScroll = () => header && header.classList.toggle('is-scrolled', window.scrollY > 8);
      window.addEventListener('scroll', onScroll, { passive: true }); onScroll();

      const btn = document.getElementById('kr-menu-btn');
      const mobile = document.getElementById('kr-mobile');
      const iconOpen = document.querySelector('.kr-icon-open');
      const iconClose = document.querySelector('.kr-icon-close');
      const setMenu = (open) => {
        if (!mobile || !btn) return;
        mobile.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (iconOpen) iconOpen.style.display = open ? 'none' : 'block';
        if (iconClose) iconClose.style.display = open ? 'block' : 'none';
      };
      btn && btn.addEventListener('click', () => setMenu(mobile.hidden));
      mobile && mobile.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
      window.addEventListener('resize', () => { if (window.innerWidth >= 1056) setMenu(false); });

      const revealEls = Array.from(document.querySelectorAll('[data-reveal]'));
      setTimeout(() => revealEls.forEach(el => el.classList.add('revealed')), 1400);
      const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const delay = parseInt(entry.target.getAttribute('data-reveal-delay') || '0', 10);
            setTimeout(() => entry.target.classList.add('revealed'), delay);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      revealEls.forEach(el => io.observe(el));
    </script>
  </body>
</html>
